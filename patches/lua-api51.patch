diff --git a/third_party/lua/lauxlib.h b/third_party/lua/lauxlib.h
index 5b977e2..f5a3323 100644
--- a/third_party/lua/lauxlib.h
+++ b/third_party/lua/lauxlib.h
@@ -11,6 +11,7 @@
 
 #include <stddef.h>
 #include <stdio.h>
+#include <string.h>
 
 #include "luaconf.h"
 #include "lua.h"
@@ -296,6 +297,41 @@ typedef struct luaL_Stream {
 
 
 
+
+/*
+** vlr: the Lua 5.1 C API names that 5.4 dropped, for modules written for 5.1 (the default dialect; patches/lua-api51.patch).
+** Only what is missing is defined, each name guarded. Define VLR_NO_LUA51_API to hide all of it. Not provided: LUA_GLOBALSINDEX/LUA_ENVIRONINDEX
+** (pseudo-indices 5.4 does not have) and lua_getfenv/lua_setfenv: modules that use them do not compile, which is the honest answer.
+*/
+#if !defined(VLR_NO_LUA51_API)
+typedef luaL_Reg luaL_reg;
+#if !defined(lua_strlen)
+#define lua_strlen(L,i)		lua_rawlen(L, (i))
+#endif
+#if !defined(lua_objlen)
+#define lua_objlen(L,i)		lua_rawlen(L, (i))
+#endif
+#if !defined(lua_equal)
+#define lua_equal(L,a,b)	lua_compare(L, (a), (b), LUA_OPEQ)
+#endif
+#if !defined(lua_lessthan)
+#define lua_lessthan(L,a,b)	lua_compare(L, (a), (b), LUA_OPLT)
+#endif
+#if !defined(luaL_checkint)
+#define luaL_checkint(L,n)	((int)luaL_checkinteger(L, (n)))
+#define luaL_optint(L,n,d)	((int)luaL_optinteger(L, (n), (d)))
+#define luaL_checklong(L,n)	((long)luaL_checkinteger(L, (n)))
+#define luaL_optlong(L,n,d)	((long)luaL_optinteger(L, (n), (d)))
+#endif
+#define lua_open()		luaL_newstate()
+#define lua_getregistry(L)	lua_pushvalue(L, LUA_REGISTRYINDEX)
+
+/* functions in 5.1, not macros: rocks that carry their own copy (compat layers) must still compile, so these are weak definitions in lauxlib.c */
+LUALIB_API void (luaL_openlib) (lua_State *L, const char *libname, const luaL_Reg *l, int nup);
+LUALIB_API void (luaL_register) (lua_State *L, const char *libname, const luaL_Reg *l);
+LUALIB_API int (luaL_typerror) (lua_State *L, int narg, const char *tname);
+#endif
+
 #endif
 
 
diff --git a/third_party/lua/lauxlib.c b/third_party/lua/lauxlib.c
index 35acf94..c6f30ca 100644
--- a/third_party/lua/lauxlib.c
+++ b/third_party/lua/lauxlib.c
@@ -1129,3 +1129,60 @@ LUALIB_API void luaL_checkversion_ (lua_State *L, lua_Number ver, size_t sz) {
                   (LUAI_UACNUMBER)ver, (LUAI_UACNUMBER)v);
 }
 
+
+/* vlr: Lua 5.1 module registration, for C modules written against the 5.1 API (see lauxlib.h). Weak: a module or bundle carrying its own copy wins. */
+#if defined(__GNUC__)
+#define VLR_WEAK __attribute__((weak))
+#else
+#define VLR_WEAK
+#endif
+
+static void vlr51_pushmodule (lua_State *L, const char *full) {
+  const char *name = full, *e;
+  luaL_getsubtable(L, LUA_REGISTRYINDEX, LUA_LOADED_TABLE);
+  lua_getfield(L, -1, full);
+  if (!lua_istable(L, -1)) {
+    lua_pop(L, 1);
+    lua_pushglobaltable(L);
+    while ((e = strchr(name, '.')) != NULL) {   /* dotted names nest global tables */
+      lua_pushlstring(L, name, (size_t)(e - name));
+      if (lua_rawget(L, -2) != LUA_TTABLE) {
+        lua_pop(L, 1);
+        lua_pushlstring(L, name, (size_t)(e - name));
+        lua_newtable(L);
+        lua_rawset(L, -3);
+        lua_pushlstring(L, name, (size_t)(e - name));
+        lua_rawget(L, -2);
+      }
+      lua_remove(L, -2);
+      name = e + 1;
+    }
+    lua_getfield(L, -1, name);
+    if (!lua_istable(L, -1)) {
+      lua_pop(L, 1);
+      lua_newtable(L);
+      lua_pushvalue(L, -1);
+      lua_setfield(L, -3, name);
+    }
+    lua_remove(L, -2);
+    lua_pushvalue(L, -1);
+    lua_setfield(L, -3, full);
+  }
+  lua_remove(L, -2);
+}
+
+VLR_WEAK LUALIB_API void (luaL_openlib) (lua_State *L, const char *libname, const luaL_Reg *l, int nup) {
+  if (libname) {
+    vlr51_pushmodule(L, libname);
+    lua_insert(L, -(nup + 1));
+  }
+  if (l) luaL_setfuncs(L, l, nup); else lua_pop(L, nup);
+}
+
+VLR_WEAK LUALIB_API void (luaL_register) (lua_State *L, const char *libname, const luaL_Reg *l) {
+  luaL_openlib(L, libname, l, 0);
+}
+
+VLR_WEAK LUALIB_API int (luaL_typerror) (lua_State *L, int narg, const char *tname) {
+  return luaL_typeerror(L, narg, tname);
+}
